# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Google Gemini (Free key at https://aistudio.google.com/app/apikey) -------
# Paste your Gemini API key below:
GEMINI_API_KEY=

# --- OpenAI (Alternative - leave blank if using Gemini) -----------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=                       # optional (Azure/OpenRouter/proxy). Leave blank for default
LLM_MODEL=                             # Leave blank to auto-select (gemini-2.0-flash or gpt-4o-mini)
ASR_MODEL=whisper-1                    # OpenAI speech-to-text model (used only if OPENAI_API_KEY is set)
EMBEDDING_MODEL=                       # Leave blank to auto-select (text-embedding-004 or text-embedding-3-small)
OPENAI_TTS_MODEL=tts-1                 # Used for English agent voice and WAV test-call synthesis
OPENAI_TTS_VOICE=alloy

# --- Native TTS (Edge TTS - free, no key) ----------------------------------
TTS_PROVIDER=edge                      # edge | openai   (edge gives native fil-PH / id-ID voices)
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_FIL=fil-PH-BlessicaNeural    # Filipino female. Alt: fil-PH-AngeloNeural
TTS_VOICE_ID=id-ID-GadisNeural         # Indonesian female. Alt: id-ID-ArdiNeural

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Business actions (Q1) --------------------------------------------------
ESCALATION_WEBHOOK_URL=                # optional: POST JSON here on human escalation (e.g. https://webhook.site/...)
CRM_FILE=data/crm/leads.jsonl          # mock CRM store

# --- Q4 real-time pipeline ---------------------------------------------------
Q4_CHUNK_SECONDS=3                     # audio chunk size replayed at real-time speed
Q4_CONFIDENCE_THRESHOLD=0.65           # nudges below this confidence are suppressed
Q4_COOLDOWN_SECONDS=45                 # same-topic nudge cooldown
Q4_NUDGE_TTL_SECONDS=60                # nudge expiry
Q4_USE_LLM_SIGNALS=true                # set false for rule-only (zero-cost) mode
